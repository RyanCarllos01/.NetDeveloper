@model ProjetoMVC.Models.Contato

@{
    ViewData["Title"] = "Criar novo contato";
}

<h1>Criar novo contato</h1>

</hr>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Criar">
            <div class="form-group"
                <label asp-for="Nome" class="control-lable"></label>
                <input asp-for="Nome" class="form-control"></>
            </div>
            <div class="form-group"
                <label asp-for="Telefone" class="control-lable"></label>
                <input asp-for="Telefone" class="form-control"></label>
            </div>
            <div class="form-group"
                <label asp-for="Ativo" class="control-lable"></label>
                <input type="checkbox" value="Criar" class="btn btn-primary"></input>
                
            <div class="form-group">
                <br>
                <button type="submit" value="Criar" class="btn btn-primary">Criar</button>
            </div>
            </div>
            
            </form>
        </div>
</div>
</hr>
<br>
<div>
     <a asp-action="Index">Voltar</a>
</div>